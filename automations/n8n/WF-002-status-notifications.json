    {
      "id": "20b19463-4633-4589-adb7-7455ced88e01",
      "name": "Normalizar y escapar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = $input.first().json;\nconst src = raw.body ?? raw;\n\n// Escapado en un solo sitio. Los correos se redactan en HTML, y patientName, specialtyName y\n// reason vienen de la base: un nombre con < o & rompia el mensaje, y en el peor caso inyectaba\n// marcado en el correo del paciente.\nconst esc = (value) => String(value ?? \"\")\n  .replace(/&/g, \"&amp;\")\n  .replace(/</g, \"&lt;\")\n  .replace(/>/g, \"&gt;\")\n  .replace(/\"/g, \"&quot;\")\n  .replace(/'/g, \"&#39;\");\n\n// El correo del destinatario no se escapa: no va al cuerpo HTML sino al campo sendTo, y escaparlo\n// lo convertiria en una direccion invalida.\nconst email = String(src.patientEmail ?? \"\").trim();\n\nreturn [{ json: {\n  event: String(src.event ?? \"\"),\n  appointmentId: String(src.appointmentId ?? \"\"),\n  status: String(src.status ?? \"\"),\n  patientEmail: email,\n  patientName: esc(src.patientName),\n  professionalName: esc(src.professionalName),\n  specialtyName: esc(src.specialtyName),\n  locationName: esc(src.locationName),\n  reason: esc(src.reason),\n  startAt: String(src.startAt ?? \"\")\n} }];"
      }
    },
