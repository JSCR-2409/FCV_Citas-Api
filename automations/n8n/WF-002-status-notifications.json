                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "leftValue": "={{ $json.event }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "APPOINTMENT_DECIDED" }],
                "combinator": "and"
